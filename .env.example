# OmniMail Configuration Environment Variables

# Server & Application Settings
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_PATH=./omnimail.db

# Cloud Delivery Gateway (SMTP / Relay)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=gateway_user
SMTP_PASS=gateway_secret
SMTP_FROM_DEFAULT=notifications@omnimail.local

# Security & JWT Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production
MASTER_API_KEY=omni_live_master_key_9988776655

# Universal Checkout Payment Gateway Integration
CHECKOUT_MERCHANT_ID=MERCHANT_DEMO_ID
CHECKOUT_SECRET_KEY=demo_secret_key_for_hmac_signing
CHECKOUT_WEBHOOK_URL=http://localhost:3000/api/webhooks/checkout

# AI Agent (MCP Server) Configuration
MCP_SERVER_NAME=omnimail-mcp-server
MCP_SERVER_VERSION=1.0.0
MCP_RATE_LIMIT_PER_MIN=600
