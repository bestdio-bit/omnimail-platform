{
  "name": "omnimail",
  "version": "1.0.0",
  "description": "Next-Generation Enterprise Email Infrastructure & Workflow Platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --no-warnings --experimental-sqlite src/server.js",
    "worker": "node --no-warnings --experimental-sqlite src/worker.js",
    "dev": "node --no-warnings --experimental-sqlite src/server.js & node --no-warnings --experimental-sqlite src/worker.js",
    "test": "node --no-warnings --experimental-sqlite test/verify_platform.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.14",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "mailparser": "^3.9.12",
    "smtp-server": "^3.19.1"
  }
}
